<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/onyx_background</item>
        <item name="android:navigationBarColor">@color/onyx_background</item>
    </style>

    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/onyx_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@color/onyx_background</item>
        <item name="android:navigationBarColor">@color/onyx_background</item>
        <item name="colorAccent">@color/onyx_accent</item>
    </style>
</resources>
