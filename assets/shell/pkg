#!/bin/sh
set -e
if command -v apk >/dev/null 2>&1; then
  cmd="$1"
  shift 2>/dev/null || true
  case "$cmd" in
    update|upgrade) exec apk update "$@" ;;
    install|in|i) exec apk add "$@" ;;
    uninstall|remove|rm|del) exec apk del "$@" ;;
    list|ls) exec apk list -I "$@" ;;
    search|s) exec apk search "$@" ;;
    info) exec apk info "$@" ;;
    help|-h|--help|"")
      echo "Onyx pkg (Alpine apk)"
      echo "  pkg update"
      echo "  pkg install curl git nodejs npm python3"
      echo "  pkg uninstall <name>"
      echo "  pkg list | pkg search <q>"
      ;;
    *) echo "pkg: unknown '$cmd' (Alpine mode)"; exit 1 ;;
  esac
  exit 0
fi
echo "pkg: Alpine rootfs belum aktif."
echo "     Bootstrap rootfs dulu dari app, lalu buka terminal lokal."
exit 1
