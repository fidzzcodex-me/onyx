export HOME="${HOME:-$PREFIX/../home}"
export PREFIX="${PREFIX:-$HOME/../usr}"
export PATH="$PREFIX/bin:$PATH"
export TERM="${TERM:-xterm-256color}"

_onyx_pwd() {
  _p=$(pwd 2>/dev/null)
  case "$_p" in
    "$HOME"*) _p="~${_p#"$HOME"}" ;;
  esac
  printf '%s' "$_p"
}

if [ -n "$BASH_VERSION" ]; then
  __onyx_prompt() {
    local s=$?
    if [ "$s" -eq 0 ]; then
      PS1="$(_onyx_pwd) \$ "
    else
      PS1="$(_onyx_pwd) [$s] \$ "
    fi
  }
  PROMPT_COMMAND=__onyx_prompt
else
  PS1='$(_onyx_pwd) $ '
fi

alias ls='ls --color=auto 2>/dev/null || ls'
alias ll='ls -la'
alias la='ls -la'
alias ..='cd ..'
alias sdcard='cd /sdcard 2>/dev/null || cd /storage/emulated/0'
alias storage='cd /storage/emulated/0'
alias downloads='cd /sdcard/Download 2>/dev/null || cd /storage/emulated/0/Download'

command -v pkg >/dev/null 2>&1 || [ -x "$PREFIX/bin/pkg" ] && alias pkg='sh "$PREFIX/bin/pkg"'

[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc" 2>/dev/null
